  G -->|No| H{"Transitorio e intento menor a 3?"}
  H -->|Si| F
  H -->|No| P
  G -->|Si| X["EXPORT_EXCEL"]
  P --> X
  X --> Y{"Exportacion correcta?"}
  Y -->|No| ERR["ERROR + conservar JSON"]
  Y -->|Si| Z["FINALIZE: cerrar navegador, eventos y SQL"]
  ERR --> Z
  Z --> END["OK solo si todo confirmado; PARCIAL o ERROR en fallos"]
  NOTE["DISENO: comprobacion en Studio pendiente"]
